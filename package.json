{
  "name": "arborcursus-web",
  "version": "1.0.0",
  "description": "ArborCursus web workspace",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "bun-plugin-tailwind": "^0.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "process": "^0.11.10",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
